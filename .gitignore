# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.out
coverage.html
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Project binary
image-tools-mcp

# Distribution directory
dist/

# Temporary files
*.tmp
*.temp
.claude/settings.local.json
.vscode/settings.local.json

# Build outputs
builds/

# Tessdata files (downloaded at build time by scripts/ensure-tessdata.sh)
internal/ocr/tessdata/*.traineddata
DOCs/DO-NOT-USE.zip
.DS_Store

# Devcontainer local override (private mounts, machine-specific)
.devcontainer/docker-compose.override.yml

# Completed sprint plans are moved here and intentionally not tracked
DOCs/plans/archive/

# todo-mcp local task archive (machine-local tooling state)
/tasks/

# Runtime tessdata the binary self-extracts next to its CWD when run from the
# repo root (e.g. local OCR smoke tests); the embedded copy lives under internal/ocr/
/tessdata/
